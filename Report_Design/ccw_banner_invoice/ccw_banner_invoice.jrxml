<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ccw_banner_invoice" pageWidth="595" pageHeight="842" columnWidth="515" leftMargin="40" rightMargin="40" topMargin="40" bottomMargin="40" uuid="b0000000-0000-4000-8000-000000000001">
<parameter name="BOOKING_NO" class="java.lang.String"/>
<queryString><![CDATA[SELECT b.booking_no AS BOOKING_NO, b.booking_date AS BOOKING_DATE, b.advertiser_name AS ADVERTISER_NAME,
 CASE b.advertiser_type WHEN 'M' THEN 'Member' WHEN 'T' THEN 'Tenant' WHEN 'E' THEN 'External' ELSE b.advertiser_type END AS ADVERTISER_TYPE_DESC,
 b.unit_no AS UNIT_NO, u.wing_code AS WING_CODE, b.contact_no AS CONTACT_NO, b.email AS EMAIL, b.banner_title AS BANNER_TITLE,
 b.start_date AS START_DATE, CAST(b.start_date + (b.no_of_months * INTERVAL '1 month') AS DATE) AS END_DATE, b.no_of_months AS NO_OF_MONTHS,
 b.rate_per_month AS RATE_PER_MONTH, b.amount AS AMOUNT, b.tax_pct AS TAX_PCT, b.tax_amount AS TAX_AMOUNT, b.total_amount AS TOTAL_AMOUNT,
 b.invoice_no AS INVOICE_NO, b.invoice_date AS INVOICE_DATE,
 CASE b.payment_status WHEN 'P' THEN 'Paid' ELSE 'Unpaid' END AS PAYMENT_STATUS_DESC,
 CASE b.payment_mode WHEN 'C' THEN 'Cash' WHEN 'Q' THEN 'Cheque' WHEN 'B' THEN 'Bank Transfer' WHEN 'U' THEN 'UPI' ELSE NULL END AS PAYMENT_MODE_DESC,
 b.payment_reference AS PAYMENT_REFERENCE, b.payment_date AS PAYMENT_DATE
FROM ccw_banner_booking b LEFT JOIN ccw_unit_master u ON u.unit_no = b.unit_no
WHERE b.booking_status = 'A' AND ($P{BOOKING_NO} IS NULL OR $P{BOOKING_NO} = '%' OR b.booking_no = $P{BOOKING_NO})
ORDER BY b.booking_no]]></queryString>
