{
  "table_name": "CCW_EVENT",
  "table_description": "",
  "project": "Commercial_Complex_Where",
  "columns": [
    {
      "column_name": "EVENT_NO",
      "data_type": "VARCHAR",
      "size": "10",
      "key": true,
      "description": "Auto-generated event number",
      "sequence": 1,
      "mandatory": true
    },
    {
      "column_name": "TITLE",
      "data_type": "VARCHAR",
      "size": "200",
      "key": false,
      "description": "Event title",
      "sequence": 2,
      "mandatory": true
    },
    {
      "column_name": "ANNOUNCEMENT_CATEGORY",
      "data_type": "VARCHAR",
      "size": "10",
      "key": false,
      "description": "Announcement category",
      "sequence": 3,
      "mandatory": true,
      "lookup": {
        "table": "CCW_ANNOUNCE_CATEGORY",
        "display_column": "NAME",
        "value_column": "ANNOUNCEMENT_CATEGORY_CODE"
      }
    },
    {
      "column_name": "VENUE",
      "data_type": "VARCHAR",
      "size": "200",
      "key": false,
      "description": "Where the event takes place",
      "sequence": 4,
      "mandatory": true
    },
    {
      "column_name": "START_DATE_TIME",
      "data_type": "DATETIME",
      "size": "",
      "key": false,
      "description": "Event start date and time",
      "sequence": 5,
      "mandatory": true
    },
    {
      "column_name": "END_DATE_TIME",
      "data_type": "DATETIME",
      "size": "",
      "key": false,
      "description": "Event end date and time (must be after start)",
      "sequence": 6,
      "mandatory": true
    },
    {
      "column_name": "DESCRIPTION",
      "data_type": "TEXT",
      "size": "",
      "key": false,
      "description": "Event details",
      "sequence": 7
    },
    {
      "column_name": "EVENT_IMAGE",
      "data_type": "VARCHAR",
      "size": "500",
      "key": false,
      "description": "Event poster/image",
      "sequence": 8
    },
    {
      "column_name": "ORGANISER",
      "data_type": "VARCHAR",
      "size": "100",
      "key": false,
      "description": "Organiser name",
      "sequence": 9
    },
    {
      "column_name": "ORGANISER_CONTACT_NO",
      "data_type": "VARCHAR",
      "size": "15",
      "key": false,
      "description": "Organiser contact number",
      "sequence": 10
    },
    {
      "column_name": "AUDIENCE",
      "data_type": "VARCHAR",
      "size": "1",
      "key": false,
      "description": "Who receives the event announcement",
      "sequence": 11,
      "mandatory": true,
      "allowed_values": [
        {
          "value": "A",
          "label": "All Members & Tenants"
        },
        {
          "value": "O",
          "label": "Owners Only"
        },
        {
          "value": "W",
          "label": "Specific Wing"
        }
      ]
    },
    {
      "column_name": "WING_CODE",
      "data_type": "VARCHAR",
      "size": "10",
      "key": false,
      "description": "Wing (mandatory when audience is Specific Wing)",
      "sequence": 12,
      "lookup": {
        "table": "CCW_WING_MASTER",
        "display_column": "WING_NAME",
        "value_column": "WING_CODE"
      }
    },
    {
      "column_name": "STATUS",
      "data_type": "VARCHAR",
      "size": "1",
      "key": false,
      "description": "Draft / Published / Cancelled; changed by Publish and Cancel",
      "sequence": 13,
      "mandatory": true,
      "allowed_values": [
        {
          "value": "D",
          "label": "Draft"
        },
        {
          "value": "P",
          "label": "Published"
        },
        {
          "value": "C",
          "label": "Cancelled"
        }
      ]
    },
    {
      "column_name": "CANCELLATION_REASON",
      "data_type": "VARCHAR",
      "size": "500",
      "key": false,
      "description": "Filled by the Cancel action",
      "sequence": 14
    },
    {
      "column_name": "ADD_DATE",
      "data_type": "DATETIME",
      "size": "",
      "key": false,
      "description": "Audit: added on",
      "sequence": 15
    },
    {
      "column_name": "ADD_USER",
      "data_type": "VARCHAR",
      "size": "10",
      "key": false,
      "description": "Audit: added by",
      "sequence": 16
    },
    {
      "column_name": "ADD_TERM",
      "data_type": "VARCHAR",
      "size": "15",
      "key": false,
      "description": "Audit: added from",
      "sequence": 17
    },
    {
      "column_name": "CHG_DATE",
      "data_type": "DATETIME",
      "size": "",
      "key": false,
      "description": "Audit: changed on",
      "sequence": 18
    },
    {
      "column_name": "CHG_USER",
      "data_type": "VARCHAR",
      "size": "10",
      "key": false,
      "description": "Audit: changed by",
      "sequence": 19
    },
    {
      "column_name": "CHG_TERM",
      "data_type": "VARCHAR",
      "size": "15",
      "key": false,
      "description": "Audit: changed from",
      "sequence": 20
    }
  ]
}