{
  "table_name": "CCW_FACILITY_REQUEST",
  "table_description": "",
  "project": "Commercial_Complex_Where",
  "columns": [
    {
      "column_name": "REQUEST_NO",
      "data_type": "VARCHAR",
      "size": "10",
      "key": true,
      "description": "Auto-generated request number",
      "sequence": 1,
      "mandatory": true
    },
    {
      "column_name": "REQUEST_DATE_TIME",
      "data_type": "DATETIME",
      "size": "",
      "key": false,
      "description": "Date and time raised",
      "sequence": 2,
      "mandatory": true
    },
    {
      "column_name": "RAISED_BY_EMAIL",
      "data_type": "VARCHAR",
      "size": "100",
      "key": false,
      "description": "Raiser email (defaults to the signed-in user)",
      "sequence": 3,
      "mandatory": true
    },
    {
      "column_name": "UNIT_NO",
      "data_type": "VARCHAR",
      "size": "10",
      "key": false,
      "description": "Unit the request is about (defaults from the user's unit)",
      "sequence": 4,
      "mandatory": true,
      "lookup": {
        "table": "CCW_UNIT_MASTER",
        "display_column": "UNIT_NO",
        "value_column": "UNIT_NO"
      }
    },
    {
      "column_name": "RAISED_BY_NAME",
      "data_type": "VARCHAR",
      "size": "100",
      "key": false,
      "description": "Name of the raiser",
      "sequence": 5
    },
    {
      "column_name": "RAISED_BY_CONTACT_NO",
      "data_type": "VARCHAR",
      "size": "15",
      "key": false,
      "description": "Raiser contact number",
      "sequence": 6
    },
    {
      "column_name": "REQUEST_CATEGORY",
      "data_type": "VARCHAR",
      "size": "10",
      "key": false,
      "description": "Facility request category (drives the target resolution time)",
      "sequence": 7,
      "mandatory": true,
      "lookup": {
        "table": "CCW_FACILITY_REQ_CATEGORY",
        "display_column": "NAME",
        "value_column": "REQUEST_CATEGORY_CODE"
      }
    },
    {
      "column_name": "PRIORITY",
      "data_type": "VARCHAR",
      "size": "1",
      "key": false,
      "description": "Low / Medium / High / Urgent",
      "sequence": 8,
      "mandatory": true,
      "allowed_values": [
        {
          "value": "L",
          "label": "Low"
        },
        {
          "value": "M",
          "label": "Medium"
        },
        {
          "value": "H",
          "label": "High"
        },
        {
          "value": "U",
          "label": "Urgent"
        }
      ]
    },
    {
      "column_name": "LOCATION_DETAIL",
      "data_type": "VARCHAR",
      "size": "200",
      "key": false,
      "description": "Where exactly (floor, passage, room)",
      "sequence": 9
    },
    {
      "column_name": "DESCRIPTION",
      "data_type": "VARCHAR",
      "size": "1000",
      "key": false,
      "description": "Details of the concern",
      "sequence": 10,
      "mandatory": true
    },
    {
      "column_name": "ATTACHMENT",
      "data_type": "VARCHAR",
      "size": "500",
      "key": false,
      "description": "Photo or document",
      "sequence": 11
    },
    {
      "column_name": "ASSIGNED_TO",
      "data_type": "VARCHAR",
      "size": "10",
      "key": false,
      "description": "Facility team member (set before pressing Assign)",
      "sequence": 12,
      "lookup": {
        "table": "CCW_FACILITY_TEAM_MEMBER",
        "display_column": "STAFF_NAME",
        "value_column": "STAFF_CODE"
      }
    },
    {
      "column_name": "STATUS",
      "data_type": "VARCHAR",
      "size": "1",
      "key": false,
      "description": "Open / Assigned / In Progress / Resolved / Closed / Cancelled; changed by actions",
      "sequence": 13,
      "mandatory": true,
      "allowed_values": [
        {
          "value": "O",
          "label": "Open"
        },
        {
          "value": "A",
          "label": "Assigned"
        },
        {
          "value": "P",
          "label": "In Progress"
        },
        {
          "value": "R",
          "label": "Resolved"
        },
        {
          "value": "C",
          "label": "Closed"
        },
        {
          "value": "X",
          "label": "Cancelled"
        }
      ]
    },
    {
      "column_name": "RESOLUTION_NOTE",
      "data_type": "VARCHAR",
      "size": "1000",
      "key": false,
      "description": "Filled by Resolve",
      "sequence": 14
    },
    {
      "column_name": "RESOLVED_ON",
      "data_type": "DATETIME",
      "size": "",
      "key": false,
      "description": "Filled by Resolve",
      "sequence": 15
    },
    {
      "column_name": "CLOSED_ON",
      "data_type": "DATETIME",
      "size": "",
      "key": false,
      "description": "Filled by Close",
      "sequence": 16
    },
    {
      "column_name": "ADD_DATE",
      "data_type": "DATETIME",
      "size": "",
      "key": false,
      "description": "Audit: added on",
      "sequence": 17
    },
    {
      "column_name": "ADD_USER",
      "data_type": "VARCHAR",
      "size": "10",
      "key": false,
      "description": "Audit: added by",
      "sequence": 18
    },
    {
      "column_name": "ADD_TERM",
      "data_type": "VARCHAR",
      "size": "15",
      "key": false,
      "description": "Audit: added from",
      "sequence": 19
    },
    {
      "column_name": "CHG_DATE",
      "data_type": "DATETIME",
      "size": "",
      "key": false,
      "description": "Audit: changed on",
      "sequence": 20
    },
    {
      "column_name": "CHG_USER",
      "data_type": "VARCHAR",
      "size": "10",
      "key": false,
      "description": "Audit: changed by",
      "sequence": 21
    },
    {
      "column_name": "CHG_TERM",
      "data_type": "VARCHAR",
      "size": "15",
      "key": false,
      "description": "Audit: changed from",
      "sequence": 22
    }
  ]
}