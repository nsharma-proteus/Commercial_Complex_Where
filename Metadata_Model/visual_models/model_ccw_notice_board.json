  "SOURCE_SQL": "SELECT n.title AS TITLE, n.is_important AS IS_IMPORTANT, c.name AS CATEGORY, n.publish_date AS PUBLISH_DATE, LEFT(n.notice_body, 200) AS SHORT_BODY, n.expiry_date AS EXPIRY_DATE FROM ccw_notice n JOIN ccw_announce_category c ON c.announcement_category_code = n.announcement_category WHERE n.status = 'P' AND n.publish_date <= CURRENT_DATE AND (?.show_expired = 'Y' OR n.expiry_date IS NULL OR n.expiry_date >= CURRENT_DATE) AND n.announcement_category LIKE ?.category AND COALESCE(n.wing_code, '') LIKE ?.wing AND n.is_important LIKE ?.important_only ORDER BY CASE WHEN n.is_important = 'Y' THEN 0 ELSE 1 END, n.publish_date DESC, n.notice_no DESC"
}