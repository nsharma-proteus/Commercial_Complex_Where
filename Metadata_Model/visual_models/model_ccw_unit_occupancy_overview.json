  "SOURCE_SQL": "SELECT w.wing_name AS WING_NAME, u.unit_no AS UNIT_NO, u.floor_no AS FLOOR_NO, u.occupancy_status AS OCCUPANCY_STATUS, m.business_name AS BUSINESS_NAME, t.tenant_company_name AS TENANT_COMPANY_NAME, (SELECT COUNT(*) FROM ccw_unit_parking p WHERE p.unit_no = u.unit_no) AS PARKING_SLOT_COUNT, CASE WHEN m.unit_no IS NULL THEN 'No' ELSE 'Yes' END AS PROFILE_COMPLETED FROM ccw_unit_master u JOIN ccw_wing_master w ON w.wing_code = u.wing_code LEFT JOIN ccw_member_profile m ON m.unit_no = u.unit_no LEFT JOIN ccw_tenant_profile t ON t.unit_no = u.unit_no AND t.tenant_status = 'A' WHERE u.wing_code LIKE ?.wing_code ORDER BY w.wing_name, u.floor_no, u.unit_no"
}