  "SOURCE_SQL": "SELECT e.start_date_time AS START_DATE_TIME, e.end_date_time AS END_DATE_TIME, c.name AS CATEGORY, e.title AS TITLE, e.venue AS VENUE, e.status AS STATUS, e.event_no AS EVENT_NO FROM ccw_event e JOIN ccw_announce_category c ON c.announcement_category_code = e.announcement_category WHERE e.start_date_time::date >= ?.from_date AND e.start_date_time::date <= ?.to_date AND e.announcement_category LIKE ?.category AND e.status IN ?.status ORDER BY e.start_date_time"
}