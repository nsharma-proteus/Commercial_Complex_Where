  "SOURCE_SQL": "SELECT b.booking_no AS BOOKING_NO, b.advertiser_name AS ADVERTISER_NAME, b.unit_no AS UNIT_NO, b.start_date AS START_DATE, (b.start_date + make_interval(months => b.no_of_months::int))::date - 1 AS END_DATE, b.no_of_months AS NO_OF_MONTHS, b.total_amount AS TOTAL_AMOUNT, CASE WHEN b.payment_status = 'P' THEN b.total_amount ELSE 0 END AS RECEIVED_AMOUNT, b.booking_status AS BOOKING_STATUS, b.payment_status AS PAYMENT_STATUS, CASE WHEN CURRENT_DATE > (b.start_date + make_interval(months => b.no_of_months::int))::date - 1 THEN 'Ended' WHEN b.booking_status = 'A' AND b.payment_status = 'P' AND CURRENT_DATE >= b.start_date THEN 'Live' ELSE 'Scheduled' END AS DISPLAY_STATE FROM ccw_banner_booking b WHERE b.start_date >= ?.from_date AND b.start_date <= ?.to_date AND b.booking_status IN ?.booking_status AND b.payment_status IN ?.payment_status AND b.advertiser_type IN ?.advertiser_type ORDER BY b.start_date, b.booking_no"
}