  "SOURCE_SQL": "SELECT u.unit_no AS UNIT_NO, u.wing_code AS WING_CODE, u.floor_no AS FLOOR_NO, CASE WHEN (m.occupancy_type = 'R' AND t.tenant_status = 'A' AND m.show_tenant_in_directory = 'Y' AND t.show_in_directory = 'Y') THEN t.tenant_company_name || ' (Tenant)' ELSE m.business_name END AS DISPLAY_NAME, c.category_name AS CATEGORY, CASE WHEN (m.occupancy_type = 'R' AND t.tenant_status = 'A' AND m.show_tenant_in_directory = 'Y' AND t.show_in_directory = 'Y') THEN t.contact_person ELSE m.contact_person END AS CONTACT_PERSON, CASE WHEN (m.occupancy_type = 'R' AND t.tenant_status = 'A' AND m.show_tenant_in_directory = 'Y' AND t.show_in_directory = 'Y') THEN t.contact_no_1 ELSE m.contact_no_1 END AS CONTACT_NO_1, CASE WHEN (m.occupancy_type = 'R' AND t.tenant_status = 'A' AND m.show_tenant_in_directory = 'Y' AND t.show_in_directory = 'Y') THEN t.contact_no_2 ELSE m.contact_no_2 END AS CONTACT_NO_2, CASE WHEN (m.occupancy_type = 'R' AND t.tenant_status = 'A' AND m.show_tenant_in_directory = 'Y' AND t.show_in_directory = 'Y') THEN t.tenant_email ELSE m.email END AS EMAIL, CASE WHEN m.occupancy_type = 'R' THEN 'Given on Rent' ELSE 'Owner Used' END AS OCCUPANCY_LABEL FROM ccw_unit_master u JOIN ccw_member_profile m ON m.unit_no = u.unit_no LEFT JOIN ccw_tenant_profile t ON t.unit_no = u.unit_no LEFT JOIN ccw_business_category c ON c.category_code = CASE WHEN (m.occupancy_type = 'R' AND t.tenant_status = 'A' AND m.show_tenant_in_directory = 'Y' AND t.show_in_directory = 'Y') THEN COALESCE(t.business_category, m.business_category) ELSE m.business_category END WHERE m.profile_status = 'A' AND m.show_in_directory = 'Y' AND (UPPER(u.unit_no) LIKE UPPER(?.search_text) OR UPPER(m.business_name) LIKE UPPER(?.search_text) OR UPPER(COALESCE(t.tenant_company_name, '')) LIKE UPPER(?.search_text) OR UPPER(COALESCE(CASE WHEN (m.occupancy_type = 'R' AND t.tenant_status = 'A' AND m.show_tenant_in_directory = 'Y' AND t.show_in_directory = 'Y') THEN t.contact_person ELSE m.contact_person END, '')) LIKE UPPER(?.search_text)) AND COALESCE(CASE WHEN (m.occupancy_type = 'R' AND t.tenant_status = 'A' AND m.show_tenant_in_directory = 'Y' AND t.show_in_directory = 'Y') THEN COALESCE(t.business_category, m.business_category) ELSE m.business_category END, '') LIKE ?.category_code AND u.wing_code LIKE ?.wing_code AND CAST(u.floor_no AS VARCHAR) LIKE ?.floor_no ORDER BY u.wing_code, u.floor_no, u.unit_no"
}