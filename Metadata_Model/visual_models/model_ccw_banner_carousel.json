 "SOURCE_SQL": "SELECT ROW_NUMBER() OVER (ORDER BY b.start_date, b.booking_no)::int AS DISPLAY_ORDER, b.banner_image AS BANNER_IMAGE, b.banner_title AS BANNER_TITLE, b.click_url AS CLICK_URL, COALESCE((SELECT p.seconds_per_banner FROM ccw_banner_rate_plan_master p WHERE p.status = 'A' AND p.effective_from <= CURRENT_DATE ORDER BY p.effective_from DESC LIMIT 1), 5) AS SECONDS_PER_BANNER FROM ccw_banner_booking b WHERE b.booking_status = 'A' AND b.payment_status = 'P' AND CURRENT_DATE BETWEEN b.start_date AND (b.start_date + (b.no_of_months || ' months')::interval - interval '1 day')::date ORDER BY b.start_date, b.booking_no"
}
