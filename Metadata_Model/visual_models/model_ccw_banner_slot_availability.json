 "SOURCE_SQL": "SELECT TO_CHAR(m.mon, 'YYYY-MM') AS MONTH_LABEL, COUNT(b.booking_no) AS BOOKED_SLOTS, GREATEST(MAX(pl.cap) - COUNT(b.booking_no), 0) AS AVAILABLE_SLOTS, MAX(pl.cap) AS CAPACITY FROM (SELECT (DATE_TRUNC('month', CURRENT_DATE) + (g * INTERVAL '1 month'))::date AS mon FROM generate_series(1, CAST(?.months_ahead AS integer)) AS g) m CROSS JOIN (SELECT COALESCE(MAX(max_carousel_slots), 0) AS cap FROM ccw_banner_rate_plan_master WHERE status = 'A') pl LEFT JOIN ccw_banner_booking b ON b.booking_status = 'A' AND b.start_date <= (m.mon + INTERVAL '1 month' - INTERVAL '1 day')::date AND (b.start_date + (b.no_of_months * INTERVAL '1 month') - INTERVAL '1 day')::date >= m.mon GROUP BY m.mon ORDER BY m.mon"
}
