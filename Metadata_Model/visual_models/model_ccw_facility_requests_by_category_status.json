 "SOURCE_SQL": "SELECT c.name AS REQUEST_CATEGORY, f.status AS STATUS, COUNT(f.request_no) AS REQUEST_COUNT FROM ccw_facility_request f JOIN ccw_facility_req_category c ON c.request_category_code = f.request_category JOIN ccw_unit_master u ON u.unit_no = f.unit_no WHERE f.request_date_time >= ?.from_date AND f.request_date_time < CAST(?.to_date AS date) + 1 AND u.wing_code LIKE ?.wing_code GROUP BY c.name, f.status ORDER BY c.name, f.status"
}
