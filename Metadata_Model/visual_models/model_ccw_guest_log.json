  "SOURCE_SQL": "SELECT g.guest_entry_no AS GUEST_ENTRY_NO, g.guest_name AS GUEST_NAME, g.guest_mobile AS GUEST_MOBILE, g.unit_no AS UNIT_NO, p.purpose_name AS PURPOSE, g.entry_type AS ENTRY_TYPE, g.status AS STATUS, g.check_in_time AS CHECK_IN_TIME, g.check_out_time AS CHECK_OUT_TIME, CAST(EXTRACT(EPOCH FROM (g.check_out_time - g.check_in_time)) / 60 AS integer) AS DURATION_MINUTES, g.vehicle_no AS VEHICLE_NO FROM ccw_guest_entry g LEFT JOIN ccw_guest_purpose_master p ON p.purpose_code = g.purpose WHERE g.expected_date >= ?.from_date AND g.expected_date <= ?.to_date AND g.status IN ?.status AND g.unit_no LIKE ?.unit_no AND g.entry_type IN ?.entry_type AND (g.guest_name LIKE ?.search OR g.guest_mobile LIKE ?.search) ORDER BY g.expected_date DESC, g.guest_entry_no"
}