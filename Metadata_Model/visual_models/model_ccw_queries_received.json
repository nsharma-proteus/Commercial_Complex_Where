  "SOURCE_SQL": "SELECT q.query_no AS QUERY_NO, q.query_date AS QUERY_DATE, q.raised_by_unit_no AS RAISED_BY_UNIT_NO, q.subject AS SUBJECT, q.target_business_category AS TARGET_BUSINESS_CATEGORY, q.status AS STATUS, (SELECT COUNT(*) FROM ccw_bq_response r WHERE r.query_no = q.query_no) AS RESPONSE_COUNT, CASE WHEN EXISTS (SELECT 1 FROM ccw_bq_response r2 WHERE r2.query_no = q.query_no AND r2.responder_unit_no = rc.unit_no) THEN 'Yes' ELSE 'No' END AS I_HAVE_RESPONDED FROM ccw_business_query q JOIN ccw_bq_recipient rc ON rc.query_no = q.query_no WHERE LOWER(rc.recipient_email) = LOWER(?.@User_Email) AND q.status IN ?.status AND q.query_date >= ?.from_date AND q.query_date <= ?.to_date AND q.target_business_category LIKE ?.category ORDER BY q.query_date DESC, q.query_no DESC"
}