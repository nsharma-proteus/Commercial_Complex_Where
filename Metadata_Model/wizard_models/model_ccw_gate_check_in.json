{"wizard": {
  "obj_name": "ccw_gate_check_in",
  "title": "Guard check-in",
  "description": "Guard desk wizard over Guest Entry: scan a pre-registered pass (or enter an entry number) or register a walk-in, wait for the resident's approval, confirm and check the guest in. Check In itself is the Guest Entry 'Check In' action (its BL enforces status, time-window and remark rules).",
  "base_object": "ccw_guest_entry",
  "mode": "add_or_edit",
  "inputs": [],
  "outputs": {"txn_id": "{run.txn_id}"},
  "vars": [{"name": "path", "type": "string", "default": "P"}, {"name": "entry_no", "type": "string"}],
  "start": "choose",
  "suspend": "memory",
  "scope": {"edit_when": "STATUS in ('E', 'W', 'A')"},
  "also_writes": ["header.status", "header.pass_code", "header.pass_qr", "header.registered_by", "header.expected_date"],
  "presentation": {"density": "handheld", "show_record_panel": true, "progress": "path"},
  "steps": [
    {"id": "choose", "kind": "select", "title": "How is the guest arriving?",
     "target": "var.path",
     "source": {"values": [
       {"data": "P", "display": "Scan pre-registered pass"},
       {"data": "N", "display": "Enter guest entry number"},
       {"data": "W", "display": "Walk-in (no pass)"}]},
     "display": "tiles",
     "next": [{"when": "{var.path} == \"W\"", "goto": "walkin_type"},
              {"when": "{var.path} == \"N\"", "goto": "enter_no"},
              {"goto": "scan_pass"}]},

    {"id": "scan_pass", "kind": "scan", "prompt": "Scan the guest's pass QR (or type the 6-character code)",
     "parse": {"format": "raw"}, "manual_entry": true,
     "next": "find_pass"},
    {"id": "find_pass", "kind": "load",
     "match": {"PASS_CODE": "{step.scan_pass.value}"},
     "on_found": {"mode": "edit", "goto": "route"},
     "on_missing": {"goto": "not_found"}},

    {"id": "enter_no", "kind": "input", "title": "Guest entry number",
     "fields": [{"field": "var.entry_no", "type": "string", "label": "Guest Entry No", "required": true}],
     "next": "find_no"},
    {"id": "find_no", "kind": "load",
     "match": {"GUEST_ENTRY_NO": "{var.entry_no}"},
     "on_found": {"mode": "edit", "goto": "route"},
     "on_missing": {"goto": "not_found"}},

    {"id": "not_found", "kind": "info", "title": "Not found",
     "body": "No open guest entry matches. Check the pass / number, or register the guest as a walk-in.",
     "next": "choose"},

    {"id": "walkin_type", "kind": "auto",
     "do": [{"op": "set", "target": "header.entry_type", "value": "W"}],
     "next": "walkin_guest"},
    {"id": "walkin_guest", "kind": "input", "title": "Walk-in guest",
     "fields": ["header.guest_name", "header.guest_mobile", "header.no_of_persons", "header.guest_company",
                "header.vehicle_no", "header.id_proof_type", "header.id_proof_no"],
     "next": "walkin_visit"},
    {"id": "walkin_visit", "kind": "input", "title": "Visit details",
     "fields": ["header.purpose", "header.unit_no", "header.person_to_meet"],
     "next": "walkin_confirm"},
    {"id": "walkin_confirm", "kind": "confirm", "title": "Register walk-in",
     "validate": true,
     "show": ["header.guest_name", "header.guest_mobile", "header.no_of_persons", "header.guest_company",
              "header.vehicle_no", "header.purpose_name", "header.unit_no", "header.person_to_meet"],
     "next": "walkin_save"},
    {"id": "walkin_save", "kind": "save", "warnings": "ask", "back": false,
     "on_saved": "walkin_wait", "on_pending_approval": "walkin_wait"},
    {"id": "walkin_wait", "kind": "info", "title": "Awaiting resident approval",
     "body": "Walk-in {header.guest_name} is registered as {header.guest_entry_no}. The unit has been asked to approve in the app. If they approve by phone, record it with Approve by Phone, then check the guest in by choosing 'Enter guest entry number'.",
     "tools": [{"label": "Approve by Phone", "kind": "action", "action": "Approve by Phone"}],
     "next": {"finish": true}},

    {"id": "route", "kind": "branch",
     "cases": [{"when": "in_list({header.status}, \"E,A\")", "goto": "review"},
               {"when": "{header.status} == \"W\"", "goto": "awaiting"}],
     "else": "not_found"},

    {"id": "awaiting", "kind": "info", "title": "Awaiting resident approval",
     "body": "{header.guest_name} for unit {header.unit_no} is still waiting for the resident's approval. Record a phone approval if the resident confirmed by phone, otherwise ask the guest to wait.",
     "tools": [{"label": "Approve by Phone", "kind": "action", "action": "Approve by Phone"}],
     "next": {"finish": true}},

    {"id": "review", "kind": "confirm", "title": "Confirm guest",
     "help": "Check the guest against the pass before checking in. Check In asks for a remark when the guest is outside the valid time window or date.",
     "show": ["header.guest_entry_no", "header.guest_name", "header.guest_mobile", "header.no_of_persons",
              "header.guest_company", "header.vehicle_no", "header.purpose_name", "header.unit_no",
              "header.person_to_meet", "header.expected_date", "header.valid_from_time", "header.valid_to_time",
              "header.status"],
     "next": "do_check_in"},
    {"id": "do_check_in", "kind": "action", "title": "Check in", "action": "Check In",
     "next": {"finish": true}}
  ],
  "finish": {"then": "restart", "message": "Guard check-in complete"}
}}
