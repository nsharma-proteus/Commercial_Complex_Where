    "actions": [
      {
        "name": "Delete",
        "handler": "system",
        "system_op": "delete",
        "validations": [
          {
            "type": "expression",
            "name": "Only Draft can be deleted",
            "message": "Only Draft events can be deleted; Published events must be Cancelled.",
            "expression": "{form.status} == \"D\""
          }
        ]
      },
      {
        "name": "Publish",
        "handler": "message",
        "scope": "row",
        "placement": "bar",
        "business_logic": {
          "method": "publish_event",
          "description": "Publish the event and notify the audience",
          "spec": "For the given EVENT_NO in CCW_EVENT: refuse with an error unless STATUS='D'; refuse with an error if START_DATE_TIME is earlier than the current date-time ('Start date/time cannot be in the past when publishing'). Set STATUS='P'. Then create an in-app notification and send an email to the intended audience: owners (CCW_MEMBER_OWNER.OWNER_EMAIL joined to CCW_MEMBER_PROFILE on UNIT_NO where PROFILE_STATUS='A' and LOGIN_ENABLED='Y') plus, unless AUDIENCE='O', active tenants with login (CCW_TENANT_PROFILE.TENANT_EMAIL where TENANT_STATUS='A' and LOGIN_ENABLED='Y'). When AUDIENCE='W' restrict to units (CCW_UNIT_MASTER) whose WING_CODE equals the event WING_CODE. Message includes title, venue, start and end. Return {\"message\":\"Event published\"}."
        },
        "validations": [
          {
            "type": "expression",
            "name": "Must be Draft",
            "message": "Only Draft events can be published.",
            "expression": "{form.status} == \"D\""
          }
        ],
        "visible_when": "{form.status} == \"D\"",
        "confirmation": {
          "mode": "reconfirm",
          "message": "Publish event {form.event_no} and notify the audience?"
        }
      },
      {
        "name": "Cancel",
        "handler": "message",
        "scope": "row",
        "capture": {
          "mode": "text",
          "prompt": "Reason for cancelling the event",
          "field": "CANCELLATION_REASON"
        },
        "business_logic": {
          "method": "cancel_event",
          "description": "Cancel the event and notify the audience",
          "spec": "Read the captured CANCELLATION_REASON from the payload; return an error 'Cancellation reason is required' if blank. For the given EVENT_NO in CCW_EVENT refuse unless STATUS is 'D' or 'P'. Set STATUS='C' and store CANCELLATION_REASON. If the event was Published, create an in-app notification and send an email with the reason to the same audience used by publish_event (owners from CCW_MEMBER_OWNER/CCW_MEMBER_PROFILE with LOGIN_ENABLED='Y' and active tenants with login unless AUDIENCE='O'; restricted by wing through CCW_UNIT_MASTER when AUDIENCE='W'). Return {\"message\":\"Event cancelled\"}."
        },
        "validations": [
          {
            "type": "expression",
            "name": "Draft or Published only",
            "message": "Only Draft or Published events can be cancelled.",
            "expression": "in_list({form.status}, \"D,P\")"
          }
        ],
        "visible_when": "in_list({form.status}, \"D,P\")",
        "confirmation": {
          "mode": "reconfirm",
          "message": "Cancel event {form.event_no}?"
        }
      },
