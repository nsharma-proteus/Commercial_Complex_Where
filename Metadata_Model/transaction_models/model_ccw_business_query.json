        "sql_model": {
          "form_title": "Business Query",
          "form_descr": "A member or tenant asks the community for a business service",
          "form_no": "1",
          "main_table": "CCW_BUSINESS_QUERY",
          "row_security": {
            "rules": [
              {
                "column": "RAISED_BY_EMAIL",
                "op": "in",
                "sql": "SELECT :user_email AS e UNION SELECT q.raised_by_email FROM ccw_business_query q JOIN ccw_bq_recipient r ON r.query_no = q.query_no WHERE LOWER(r.recipient_email) = LOWER(:user_email)"
              }
            ],
            "exempt_roles": [
              "admin",
              "func-admin",
              "management"
            ]
