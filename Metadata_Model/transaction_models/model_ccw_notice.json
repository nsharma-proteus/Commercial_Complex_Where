          "list_view": {
            "tabs": {
              "column": "STATUS",
              "values": [
                "D",
                "P",
                "W"
              ],
              "show_all": true,
              "counts": true,
              "default": "all"
            }
          },
          "validations": [
            {
              "type": "expression",
              "name": "Expiry not before publish",
              "error_code": "NOTICE_EXPIRY",
              "message": "Expiry date must not be before publish date.",
              "expression": "is_empty({form.expiry_date}) or {form.expiry_date} >= {form.publish_date}"
            },
            {
              "type": "expression",
              "name": "Wing needed for Specific Wing",
              "error_code": "NOTICE_WING",
              "message": "Wing is mandatory when audience is Specific Wing.",
              "expression": "{form.audience} != \"W\" or not_empty({form.wing_code})"
            }
          ]
        }
      }
