    "actions": [
      {
        "name": "Delete",
        "handler": "system",
        "system_op": "delete",
        "validations": [
          {
            "type": "expression",
            "name": "Only Draft can be deleted",
            "message": "Only Draft notices can be deleted; Published notices must be Withdrawn.",
            "expression": "{form.status} == \"D\""
          }
        ]
      },
      {
        "name": "Publish",
        "handler": "message",
        "scope": "row",
        "placement": "bar",
        "business_logic": {
          "method": "publish_notice",
          "description": "Publish the notice and notify the audience",
          "spec": "Set STATUS='P' on CCW_NOTICE for the given NOTICE_NO and stamp PUBLISHED_BY with the signed-in user's email. Create an in-app notification and send an email to the intended audience: owners (CCW_MEMBER_OWNER.OWNER_EMAIL joined to CCW_MEMBER_PROFILE on UNIT_NO where PROFILE_STATUS='A' and LOGIN_ENABLED='Y') plus, unless AUDIENCE='O', active tenants with login (CCW_TENANT_PROFILE.TENANT_EMAIL where TENANT_STATUS='A' and LOGIN_ENABLED='Y'). When AUDIENCE='W' restrict to units (CCW_UNIT_MASTER) whose WING_CODE equals the notice WING_CODE. Return {\"message\":\"Notice published\"}."
        },
        "validations": [
          {
            "type": "expression",
            "name": "Must be Draft",
            "message": "Only Draft notices can be published.",
            "expression": "{form.status} == \"D\""
          }
        ],
        "visible_when": "{form.status} == \"D\"",
        "confirmation": {
          "mode": "reconfirm",
          "message": "Publish notice {form.notice_no} and notify the audience?"
        }
      },
      {
        "name": "Withdraw",
        "handler": "message",
        "scope": "row",
        "business_logic": {
          "method": "withdraw_notice",
          "description": "Withdraw a published notice",
          "spec": "Set STATUS='W' on CCW_NOTICE for the given NOTICE_NO so it no longer shows on the Notice Board. Return {\"message\":\"Notice withdrawn\"}."
        },
        "validations": [
          {
            "type": "expression",
            "name": "Must be Published",
            "message": "Only Published notices can be withdrawn.",
            "expression": "{form.status} == \"P\""
          }
        ],
        "visible_when": "{form.status} == \"P\"",
        "confirmation": {
          "mode": "reconfirm",
          "message": "Withdraw notice {form.notice_no}?"
        }
      },
      {
        "name": "Export",
        "handler": "system",
        "system_op": "export",
        "scope": "form",
        "export": {
          "places": [
            "list",
            "bulk",
            "record"
          ],
          "formats": [
            "xlsx",
            "csv",
            "json"
          ],
          "offer_list_view": true,
          "org_templates": true,
          "templates": []
        }
      },
      {
        "name": "Import",
        "handler": "import",
        "scope": "form",
        "import": {
          "mode": "upsert"
        }
      }
    ],
