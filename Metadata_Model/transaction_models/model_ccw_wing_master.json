    "actions": [
      {
        "name": "Delete",
        "handler": "system",
        "system_op": "delete",
        "validations": [
          {
            "type": "business_logic",
            "name": "Wing has no units",
            "error_code": "WING_HAS_UNITS",
            "message": "A wing that has Units cannot be deleted. Make it Inactive instead.",
            "business_logic": {
              "method": "check_wing_delete",
              "description": "Block delete of a wing that has units",
              "spec": "Payload carries WING_CODE. If any row exists in the unit master table (ccw_unit_master, column WING_CODE) with WING_CODE equal to this wing's code, return {\"error\": \"A wing that has Units cannot be deleted. Make it Inactive instead.\"}; otherwise return None. If the unit master table does not exist yet, return None."
            }
          }
        ]
