{
  "transaction": {
    "obj_name": "ccw_unit_master",
    "sql_models": [
      {
        "sql_model": {
          "form_title": "Unit Master",
          "form_descr": "Units (shops/offices) of the complex with wing, floor, type, area and occupancy.",
          "form_no": "1",
          "main_table": "CCW_UNIT_MASTER",
          "columns": [
            {
              "column": {
                "name": "unit_no",
                "db_name": "UNIT_NO",
                "group_name": "Basic",
                "col_type": "VARCHAR",
                "heading": "Unit No",
                "descr": "Unit number, e.g. D715",
                "key": true,
                "mandatory": true,
                "text_case": "upper",
                "validations": [
                  {
                    "type": "builtin",
                    "name": "Unit no unique",
                    "error_code": "UNIT_DUP",
                    "message": "Unit {form.unit_no} already exists.",
                    "builtin": {
                      "kind": "must_be_unique"
                    }
                  }
                ],
                "x": "10",
                "y": "10",
                "col_id": "1",
                "table_name": "CCW_UNIT_MASTER",
                "table_display_name": "Unit master",
                "db_size": "10",
                "width": 100,
                "hidden": "",
                "format": "",
                "default_function": "",
                "default_value": "",
                "expression": "",
                "edit_mask": "",
                "protect": "",
                "lookup": ""
              }
            },
            {
              "column": {
                "name": "wing_code",
                "db_name": "WING_CODE",
                "group_name": "Basic",
                "col_type": "VARCHAR",
                "heading": "Wing",
                "descr": "Wing of the unit (must exist in Wing Master)",
                "mandatory": true,
                "lookup": "CCW_WING_MASTER(WING_NAME, WING_CODE)",
                "lookup_filter": "STATUS = 'A'",
                "must_exist_in": "CCW_WING_MASTER",
                "validations": [
                  {
                    "type": "builtin",
                    "name": "Wing exists",
                    "error_code": "UNIT_WING",
                    "message": "Wing {form.wing_code} not found in the Wing Master.",
                    "builtin": {
                      "kind": "must_exist_in_master",
                      "table": "CCW_WING_MASTER",
                      "match_column": "WING_CODE"
                    }
                  }
                ],
                "item_change": {
                  "mode": "rule",
                  "source_table": "CCW_WING_MASTER",
                  "match_table_col": "WING_CODE",
                  "on_no_match": "clear",
                  "fill": [
                    {
                      "form_col": "wing_floors",
                      "table_col": "NO_OF_FLOORS"
                    }
                  ]
                },
                "x": "20",
                "y": "20",
                "col_id": "2",
                "table_name": "CCW_UNIT_MASTER",
                "table_display_name": "Unit master",
                "db_size": "10",
                "width": 100,
                "key": false,
                "hidden": "",
                "format": "",
                "default_function": "",
                "default_value": "",
                "expression": "",
                "edit_mask": "",
                "protect": ""
              }
            },
            {
              "column": {
                "name": "wing_name",
                "db_name": "WING_NAME",
                "table_name": "CCW_WING_MASTER",
                "group_name": "Basic",
                "col_type": "VARCHAR",
                "heading": "Wing Name",
                "descr": "Wing name (from Wing Master)",
                "protect": "1",
                "inline_with": "wing_code",
                "x": "30",
                "y": "30",
                "col_id": "3",
                "table_display_name": "Wing master (lookup table)",
                "db_size": "100",
                "width": 500,
                "key": false,
                "mandatory": false,
                "hidden": "",
                "format": "",
                "default_function": "",
                "default_value": "",
                "expression": "",
                "edit_mask": "",
                "validations": "",
                "lookup": ""
              }
            },
            {
              "column": {
                "name": "wing_floors",
                "db_name": "NO_OF_FLOORS",
                "table_name": "CCW_WING_MASTER",
                "group_name": "Basic",
                "col_type": "NUMBER",
                "heading": "Wing Floors",
                "descr": "Number of floors in the wing (from Wing Master)",
                "protect": "1",
                "x": "40",
                "y": "40",
                "col_id": "4",
                "table_display_name": "Wing master (lookup table)",
                "db_size": "3",
                "width": 50,
                "key": false,
                "mandatory": false,
                "hidden": "",
                "format": "",
                "default_function": "",
                "default_value": "",
                "expression": "",
                "edit_mask": "",
                "validations": "",
                "lookup": ""
              }
            },
            {
              "column": {
                "name": "floor_no",
                "db_name": "FLOOR_NO",
                "group_name": "Basic",
                "col_type": "NUMBER",
                "heading": "Floor No",
                "descr": "Floor, from 0 to the wing's number of floors",
                "mandatory": true,
                "validations": [
                  {
                    "type": "builtin",
                    "name": "Floor within wing",
                    "error_code": "UNIT_FLOOR",
                    "message": "Floor {form.floor_no} must be between 0 and the wing's number of floors.",
                    "builtin": {
                      "kind": "sql_range",
                      "sql": "SELECT CASE WHEN {form.floor_no} >= 0 AND {form.floor_no} <= NO_OF_FLOORS THEN 1 ELSE 0 END FROM CCW_WING_MASTER WHERE WING_CODE = {form.wing_code}",
                      "range_min": { "source": "const", "value": "1" },
                      "on_no_row": "pass",
                      "on_error": "fail"
                    }
                  }
                ],
                "x": "50",
                "y": "50",
                "col_id": "5",
                "table_name": "CCW_UNIT_MASTER",
                "table_display_name": "Unit master",
                "db_size": "3",
                "width": 50,
                "key": false,
                "hidden": "",
                "format": "",
                "default_function": "",
                "default_value": "",
                "expression": "",
                "edit_mask": "",
                "protect": "",
                "lookup": ""
              }
            },
            {
              "column": {
                "name": "unit_type",
                "db_name": "UNIT_TYPE",
                "group_name": "Basic",
                "col_type": "VARCHAR",
                "heading": "Unit Type",
                "descr": "Shop / Office / Showroom / Other",
                "mandatory": true,
                "default_value": "S",
                "edit_mask": {
                  "mask": "ddlb",
                  "values": [
                    {
                      "data": "S",
                      "display": "Shop"
                    },
                    {
                      "data": "O",
                      "display": "Office"
                    },
                    {
                      "data": "R",
                      "display": "Showroom"
                    },
                    {
                      "data": "X",
                      "display": "Other"
                    }
                  ]
                },
                "validations": [
                  {
                    "type": "expression",
                    "name": "Unit type is a listed value",
                    "error_code": "UNIT_TYPE",
                    "message": "Unit type must be one of S, O, R, X.",
                    "expression": "in_list({form.unit_type}, \"S,O,R,X\")"
                  }
                ],
                "x": "60",
