    "vector_search": {
      "enabled": true,
      "columns": [
        "wing_code",
        "unit_type",
        "occupancy_status",
        "status",
        "area_sqft"
      ],
      "key_column": "unit_no",
      "display_column": "wing_code",
      "allow_alias": true,
      "auto": true,
      "reason": "named as a master; searched by wing_code plus unit_type, occupancy_status, status, area_sqft so same-named records stay distinguishable"
    }
