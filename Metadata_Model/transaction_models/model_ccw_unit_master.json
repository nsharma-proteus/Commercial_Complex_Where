    "actions": [
      {
        "name": "Delete",
        "handler": "system",
        "system_op": "delete",
        "validations": [
          {
            "type": "business_logic",
            "name": "Unit has no member profile",
            "error_code": "UNIT_HAS_PROFILE",
            "message": "A unit with a Member Profile cannot be deleted.",
            "business_logic": {
              "method": "check_unit_delete",
              "description": "Block delete of a unit that has a Member Profile",
              "spec": "Payload carries UNIT_NO. If any row exists in the Member Profile table (ccw_member_profile, column UNIT_NO) with UNIT_NO equal to this unit, return {\"error\": \"A unit with a Member Profile cannot be deleted.\"}; otherwise return None. If the member profile table does not exist yet, return None."
            }
          }
        ]
      },
      {
        "name": "Export",
        "handler": "system",
        "system_op": "export",
        "scope": "form",
        "export": {
          "places": [
            "list",
            "bulk",
            "record"
          ],
          "formats": [
            "xlsx",
            "csv",
            "json"
          ],
          "offer_list_view": true,
          "org_templates": true,
          "templates": []
        }
      },
      {
        "name": "Import",
        "handler": "import",
        "scope": "form",
        "import": {
          "mode": "upsert"
        }
      }
    ],
    "unit_test": {
