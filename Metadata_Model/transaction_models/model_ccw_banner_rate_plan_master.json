          "validations": [
            {
              "type": "builtin",
              "name": "One Active plan per effective date",
              "error_code": "PLAN_ACTIVE_DUP",
              "message": "Another Active plan already exists with the same Effective From date. Only one plan can be Active for a given date.",
              "builtin": {
                "kind": "sql_range",
                "sql": "SELECT CASE WHEN {form.status} = 'A' THEN (SELECT COUNT(*) FROM CCW_BANNER_RATE_PLAN_MASTER WHERE STATUS = 'A' AND EFFECTIVE_FROM = {form.effective_from} AND PLAN_CODE <> {form.plan_code}) ELSE 0 END",
                "range_max": {
                  "source": "const",
                  "value": "0"
                },
                "on_no_row": "pass",
                "on_error": "fail"
              }
            }
