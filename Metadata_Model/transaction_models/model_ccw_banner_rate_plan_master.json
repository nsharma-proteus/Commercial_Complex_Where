    "actions": [
      {
        "name": "Delete",
        "handler": "system",
        "system_op": "delete",
        "validations": [
          {
            "type": "business_logic",
            "name": "Plan not used in a booking",
            "error_code": "PLAN_IN_USE",
            "message": "This plan has been used in a banner booking and cannot be deleted. Make it Inactive instead.",
            "business_logic": {
              "method": "check_plan_not_used",
              "description": "Block delete when the plan is used in any booking",
              "spec": "Input: the plan row (PLAN_CODE). If table CCW_BANNER_BOOKING does not yet exist, return nothing (pass). Otherwise count rows in CCW_BANNER_BOOKING that reference this PLAN_CODE (the booking's rate-plan column, expected PLAN_CODE). If count > 0 return {\"error\": \"Plan <PLAN_CODE> is used in <n> banner booking(s) and cannot be deleted. Make it Inactive instead.\"}; else return nothing."
            }
          }
        ]
